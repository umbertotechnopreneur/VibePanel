{
  "description": "VibePanel: I show my Codex lifecycle status locally, without chat content.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','vibepanel_hook.py'),run_name='__main__')\"",
            "commandWindows": "py -3 -B -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','vibepanel_hook.py'),run_name='__main__')\"",
            "statusMessage": "VibePanel: Chat ready",
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
