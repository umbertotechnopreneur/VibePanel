{
  "schema": 1,
  "id": "system.pulse",
  "category": "system",
  "name": "Pulse",
  "description": "Cyan and magenta sensor lanes with real traces and RAM at the side.",
  "entry": "render.py",
  "version": "1.2.0",
  "author": "Umberto Giacobbi",
  "license": "MIT",
  "canvas": {
    "width": 1280,
    "height": 480,
    "compact": "480x480, centered without distortion for aspect ratios below 2:1"
  },
  "requires": [
    "clock"
  ],
  "optional": [
    "sensors"
  ],
  "appearance": [
    "light",
    "dark"
  ],
  "settings": {
    "fontFamily": {
      "type": "font",
      "default": "Cascadia Mono"
    },
    "fontScale": {
      "type": "number",
      "default": 1,
      "minimum": 0.65,
      "maximum": 1.6
    },
    "ambientDrift": {
      "type": "boolean",
      "default": false
    }
  },
  "branding": {
    "begin": "VBWR B",
    "end": "VBWR E"
  }
}
