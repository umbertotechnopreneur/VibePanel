{
  "schema": 1,
  "id": "system.thermal",
  "category": "system",
  "name": "Thermal Atlas",
  "description": "3 rotating pages: power & cooling, live activity, at a glance.",
  "entry": "render.py",
  "version": "2.0.0",
  "author": "Umberto Giacobbi",
  "license": "MIT",
  "canvas": {
    "width": 1280,
    "height": 480,
    "compact": "480x480, centered without distortion for aspect ratios below 2:1"
  },
  "requires": [
    "clock"
  ],
  "optional": [
    "sensors"
  ],
  "appearance": [
    "light",
    "dark"
  ],
  "settings": {
    "fontFamily": {
      "type": "font",
      "default": "Cascadia Mono"
    },
    "fontScale": {
      "type": "number",
      "default": 1,
      "minimum": 0.65,
      "maximum": 1.6
    },
    "ambientDrift": {
      "type": "boolean",
      "default": false
    }
  },
  "branding": {
    "begin": "VBWR B",
    "end": "VBWR E"
  },
  "pages": [
    {
      "id": "cooling",
      "title": "Power & cooling"
    },
    {
      "id": "activity",
      "title": "Live activity"
    },
    {
      "id": "overview",
      "title": "At a glance"
    }
  ],
  "pageSeconds": 8
}
