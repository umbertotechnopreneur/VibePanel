{
  "schema": 1,
  "id": "media.editorial",
  "category": "multimedia",
  "name": "Editorial",
  "description": "Album typography and a crisp cover on an airy editorial canvas.",
  "entry": "render.py",
  "version": "2.0.0",
  "author": "Umberto Giacobbi",
  "license": "MIT",
  "canvas": {
    "width": 1280,
    "height": 480,
    "compact": "480x480, centered without distortion for aspect ratios below 2:1"
  },
  "requires": [
    "media",
    "clock"
  ],
  "optional": [
    "audio",
    "desktop"
  ],
  "appearance": [
    "light",
    "dark"
  ],
  "settings": {
    "fontFamily": {
      "type": "font",
      "default": "Cascadia Mono"
    },
    "fontScale": {
      "type": "number",
      "default": 1,
      "minimum": 0.65,
      "maximum": 1.6
    },
    "showSpectrum": {
      "type": "boolean",
      "default": true
    },
    "ambientDrift": {
      "type": "boolean",
      "default": false
    }
  },
  "branding": {
    "begin": "VBWR B",
    "end": "VBWR E"
  },
  "pages": [
    {
      "id": "playback",
      "title": "Now playing"
    },
    {
      "id": "artist",
      "title": "About the artist"
    }
  ],
  "pageSeconds": 12
}
