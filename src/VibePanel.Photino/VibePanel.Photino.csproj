<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VibePanel</AssemblyName>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <ApplicationIcon>../VibePanel.App/Assets/vibepanel.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenSilver.Photino" Version="3.3.3" />
    <ProjectReference Include="../VibePanel.App/VibePanel.App.csproj" />
    <Content Include="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../VibePanel.App/Assets/vibepanel.ico" Link="Assets/vibepanel.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../VibePanel.App/Assets/vibepanel-icon.png" Link="Assets/vibepanel-icon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
