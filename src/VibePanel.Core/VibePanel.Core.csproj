<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>VibePanel.Core</RootNamespace>
    <AssemblyName>VibePanel.Core</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VibePanel.Data/VibePanel.Data.csproj" />
    <ProjectReference Include="../VibePanel.Contracts/VibePanel.Contracts.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- Official precompiled library only; no monitoring app or driver installer is bundled. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="[0.9.6]" />
    <!-- The sensor library uses this internally for SMBIOS. -->
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>
</Project>
