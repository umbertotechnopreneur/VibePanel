<Page x:Class="VibePanel.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="BareItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Page.Resources>
    <Grid x:Name="Root" Background="#101218">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="28,22,28,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="Eyebrow" Text="C O D E N A M E" FontSize="10"/>
                <TextBlock x:Name="Heading" Text="Vibe Panel" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                <TextBlock x:Name="Subtitle" Text="My music. My workspace. My screen." FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Border x:Name="AppearanceFrame" CornerRadius="10" BorderThickness="1" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AutoButton" Content="Auto" Click="Auto_Click" Width="60" Height="32"/>
                        <Button x:Name="LightButton" Content="Light" Click="Light_Click" Width="60" Height="32"/>
                        <Button x:Name="DarkButton" Content="Dark" Click="Dark_Click" Width="60" Height="32"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="Author" Text="by Umberto Giacobbi" FontSize="10" HorizontalAlignment="Right" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="28,0,28,0">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="284"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="LibraryFrame" CornerRadius="16" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="4,2,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LibraryHeading" Text="THEME LIBRARY" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="ReloadButton" Grid.Column="1" Content="↻" Click="Reload_Click" Width="30" Height="28" ToolTipService.ToolTip="Reload themes from local folders"/>
                    </Grid>
                    <ListBox x:Name="CategoriesBox" Grid.Row="1" BorderThickness="0" Padding="0" Margin="0,0,0,12" SelectionChanged="Category_Changed" ItemContainerStyle="{StaticResource BareItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Background="{Binding Background}" BorderBrush="{Binding Outline}" BorderThickness="1" CornerRadius="8" Padding="9,9" Margin="0,0,5,0">
                                <TextBlock Text="{Binding Name}" Foreground="{Binding Ink}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox x:Name="ThemesBox" Grid.Row="2" BorderThickness="0" Padding="0" SelectionChanged="Theme_Changed" ItemContainerStyle="{StaticResource BareItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Background="{Binding Background}" BorderBrush="{Binding Outline}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,3,6">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Foreground="{Binding Accent}" FontSize="11" Margin="0,3,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding Ink}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{Binding Muted}" FontSize="10" TextWrapping="Wrap" MaxHeight="30" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="CatalogText" Grid.Row="3" FontSize="10" Margin="4,10,0,0" Text="Discovering local themes…" TextWrapping="Wrap"/>
                </Grid>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="2,2,2,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="CategoryText" Text="MULTIMEDIA" FontSize="10"/>
                        <TextBlock x:Name="SelectedThemeText" Text="Choose a theme" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border x:Name="PreviewBadge" Grid.Column="1" CornerRadius="8" BorderThickness="1" Padding="11,7" VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewBadgeText" Text="LOCAL PREVIEW" FontSize="10"/>
                    </Border>
                </Grid>
                <Border x:Name="PreviewFrame" Grid.Row="1" CornerRadius="18" BorderThickness="1" Padding="10" MinHeight="220">
                    <Grid>
                        <Image x:Name="PreviousPreview" Stretch="Uniform"/>
                        <Image x:Name="PreviewImage" Stretch="Uniform"/>
                        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="24">
                            <TextBlock x:Name="LoadingTitle" Text="Your screen, your style." FontSize="23" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LoadingText" Text="Loading the local theme engine…" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,14,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="PreviousButton" Content="←" Click="Previous_Click" Width="38" Height="34" ToolTipService.ToolTip="Previous theme · Page Up"/>
                    <TextBlock x:Name="PositionText" Grid.Column="1" Text="00 / 00" FontSize="12" VerticalAlignment="Center" Margin="12,0"/>
                    <Button x:Name="NextButton" Grid.Column="2" Content="→" Click="Next_Click" Width="38" Height="34" ToolTipService.ToolTip="Next theme · Page Down"/>
                    <TextBlock x:Name="SourceText" Grid.Column="3" FontSize="11" VerticalAlignment="Center" Margin="18,0,12,0" TextTrimming="CharacterEllipsis"/>
                    <CheckBox x:Name="CycleBox" Grid.Column="4" Content="Cycle · 20s" VerticalAlignment="Center" FontSize="11"/>
                </Grid>
                <Border x:Name="OptionsFrame" Grid.Row="3" CornerRadius="12" BorderThickness="1" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="FontLabel" Text="FONT FAMILY" FontSize="9" Margin="0,0,0,6"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="FontBox" Text="Cascadia Mono" Height="32" Padding="8,6" FontSize="12" KeyDown="Font_KeyDown"/>
                                <Button x:Name="ApplyFontButton" Grid.Column="1" Content="Apply" Click="Font_Click" Height="32" Margin="6,0,0,0" Padding="10,0"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock x:Name="SizeLabel" Text="TEXT SIZE" FontSize="9" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SmallerButton" Content="−" Width="28" Height="32" Click="Smaller_Click"/>
                                <TextBlock x:Name="FontScaleText" Text="100%" FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
                                <Button x:Name="LargerButton" Content="+" Width="28" Height="32" Click="Larger_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="GeometryLabel" Text="DISPLAY" FontSize="9" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ProfilesBox" Width="155" Height="32" DisplayMemberPath="Name" SelectionChanged="Profile_Changed"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="30,14,28,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Local preview" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <HyperlinkButton x:Name="Manifesto" Grid.Column="1" Content="I stand with VibeWare ↗" NavigateUri="https://umbertogiacobbi.biz/vibeware/manifesto" TargetName="_blank" FontSize="10" Margin="16,0,0,0"/>
        </Grid>
    </Grid>
</Page>
