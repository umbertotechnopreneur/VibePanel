<Page x:Class="VibePanel.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#15191F">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,22" MaxWidth="1280">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="VibePanel" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="My music. My apps. My little screen." Foreground="#AEB5C2" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#292333" CornerRadius="10" Padding="18,10">
                        <StackPanel>
                            <TextBlock Text="VibeWare" Foreground="#DDB0EB" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            <TextBlock Text="by Umberto Giacobbi" Foreground="#AEB5C2" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="MY SCREEN / LIVE PREVIEW" FontFamily="Consolas" Foreground="#DDB0EB" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="LOCAL ONLY · OPENSILVER + PHOTINO" Foreground="#818A9C" FontSize="11" />
                </Grid>
                <Border Background="#202631" CornerRadius="14" BorderBrush="#393346" BorderThickness="1" Padding="1">
                    <Grid Height="260">
                        <Image x:Name="PreviousPreview" Stretch="Uniform" />
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                        <TextBlock x:Name="LoadingText" Text="Connecting to my local engine…" Foreground="#AEB5C2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Previous" Tag="previous" Click="Media_Click" />
                        <Button x:Name="ToggleButton" Content="Play / pause" Tag="toggle" Click="Media_Click" />
                        <Button Content="Next" Tag="next" Click="Media_Click" />
                    </StackPanel>
                    <TextBlock x:Name="MediaSourceText" Grid.Column="1" Text="Spotify / Windows media session" Foreground="#AEB5C2" VerticalAlignment="Center" Margin="12,0" FontSize="12" />
                    <Button Grid.Column="2" Content="Refresh" Click="Refresh_Click" Margin="0" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <ComboBox x:Name="ScenesBox" Width="200" Height="32" DisplayMemberPath="Name" SelectionChanged="Scene_Changed" />
                    <CheckBox x:Name="CycleBox" Content="Rotate five layouts · 20 s · short fade" IsChecked="True" Foreground="#BFC4D0" VerticalAlignment="Center" Margin="18,0,0,0" />
                </StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="#20252D" CornerRadius="12" Padding="17">
                        <StackPanel>
                            <TextBlock Text="APP LEVELS" FontFamily="Consolas" FontSize="13" Foreground="#DDB0EB" />
                            <TextBlock Text="Volume % + live VU · read-only · no microphone" Foreground="#AEB5C2" FontSize="12" Margin="0,7,0,12" />
                            <ScrollViewer MaxHeight="125" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MeterRows" /></ScrollViewer>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#20252D" CornerRadius="12" Padding="17">
                        <StackPanel>
                            <TextBlock Text="SYSTEM / SECONDARY" FontFamily="Consolas" FontSize="13" Foreground="#DDB0EB" />
                            <Grid Margin="0,10,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="CPU" Foreground="#AEB5C2" FontSize="12"/><TextBlock x:Name="CpuUsageText" Text="—" FontSize="28"/><TextBlock x:Name="CpuTempText" Text="— °C" FontSize="16"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="GPU" Foreground="#AEB5C2" FontSize="12"/><TextBlock x:Name="GpuUsageText" Text="—" FontSize="28"/><TextBlock x:Name="GpuTempText" Text="— °C" FontSize="16"/></StackPanel>
                            </Grid>
                            <TextBlock x:Name="SensorSourceText" Text="Existing sensors only. No driver installation." Foreground="#818A9C" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Background="#20252D" CornerRadius="12" Padding="17" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="NETWORK / SINCE ENGINE START" FontFamily="Consolas" FontSize="12" Foreground="#DDB0EB" />
                        <TextBlock x:Name="NetworkText" Text="↓ — /s    ↑ — /s    ·    total ↓ —    ↑ —" FontSize="16" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="#20252D" CornerRadius="12" Padding="17" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="USB DISPLAY / I ONLY SEND WHEN YOU PRESS START" FontFamily="Consolas" Foreground="#DDB0EB" FontSize="12" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="DevicesBox" Height="36" DisplayMemberPath="Name" />
                            <ComboBox x:Name="ProfilesBox" Grid.Column="2" Height="36" DisplayMemberPath="Name" />
                            <Button x:Name="StartButton" Grid.Column="3" Content="Start display" Click="Start_Click" Margin="12,0,8,0" />
                            <Button x:Name="StopButton" Grid.Column="4" Content="Stop" Click="Stop_Click" IsEnabled="False" Margin="0" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusText" Text="Ready. No USB display session has been started." Foreground="#AEB5C2" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="I stand with the VibeWare movement." Foreground="#AEB5C2" FontSize="12" VerticalAlignment="Center" />
                    <HyperlinkButton Content="MANIFESTO ↗" NavigateUri="https://umbertogiacobbi.biz/vibeware/manifesto" TargetName="_blank" Foreground="#DDB0EB" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
