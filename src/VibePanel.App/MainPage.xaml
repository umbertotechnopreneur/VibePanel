<Page x:Class="VibePanel.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="#15191F" Margin="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="24,18,24,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="Heading" Text="V I B E P A N E L" FontSize="21" FontWeight="SemiBold" />
                <TextBlock x:Name="Subtitle" Text="My music. My desktop. My little screen." FontSize="11" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="12,0,22,0" VerticalAlignment="Center">
                <TextBlock x:Name="Brand" Text="VibeWare" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock x:Name="Author" Text="by Umberto Giacobbi" FontSize="10" Margin="0,3,0,0" />
            </StackPanel>
            <ComboBox x:Name="ThemeBox" Grid.Column="2" Width="112" Height="34" VerticalAlignment="Center" SelectionChanged="Theme_Changed" ToolTipService.ToolTip="Automatic: light 07:00–19:00, dark at night (local PC time)">
                <ComboBoxItem Content="Auto"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/>
            </ComboBox>
        </Grid>
        <Border x:Name="PreviewFrame" Grid.Row="1" Margin="24,0" CornerRadius="14" BorderThickness="1" Padding="1">
            <Grid>
                <Image x:Name="PreviousPreview" Stretch="Uniform" />
                <Image x:Name="PreviewImage" Stretch="Uniform" />
                <TextBlock x:Name="LoadingText" Text="Connecting to my local engine…" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="24,14,24,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
            <Button Content="←" Click="Previous_Click" ToolTipService.ToolTip="Previous screen · Page Up" Width="40" Padding="0" />
            <ComboBox x:Name="ScenesBox" Grid.Column="1" Height="36" DisplayMemberPath="Name" SelectionChanged="Scene_Changed" />
            <Button Grid.Column="2" Content="→" Click="Next_Click" ToolTipService.ToolTip="Next screen · Page Down" Width="40" Padding="0" Margin="8,0,0,0" />
            <CheckBox x:Name="CycleBox" Grid.Column="4" Content="Auto · 20s" Margin="12,0" VerticalAlignment="Center" />
            <CheckBox x:Name="DriftBox" Grid.Column="5" Content="Ambient" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" ToolTipService.ToolTip="Move the cached backdrop slowly; no repeated blur or color sampling" />
            <ComboBox x:Name="ProfilesBox" Grid.Column="6" Height="36" DisplayMemberPath="Name" SelectionChanged="Profile_Changed" />
        </Grid>
        <Grid Grid.Row="3" Margin="24,0,24,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Preview only · no USB writes" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <HyperlinkButton x:Name="Manifesto" Grid.Column="1" Content="I stand with VibeWare ↗" NavigateUri="https://umbertogiacobbi.biz/vibeware/manifesto" TargetName="_blank" FontSize="10" Margin="12,0,0,0" />
        </Grid>
    </Grid>
</Page>
