<Window
    x:Class="VibePanel.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="VibePanel">
    <Grid Background="#FF252E31" Padding="28" RowDefinitions="Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock FontFamily="Cascadia Mono" FontSize="28" FontWeight="SemiBold" Foreground="White" Text="VIBE PANEL" />
                <TextBlock FontSize="16" Foreground="#FFD5D9DC" Text="I keep my USB panel simple. No sensor suite." />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                <TextBlock FontFamily="Cascadia Mono" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource VibePanelAccentBrush}" Text="VibeWare" />
                <TextBlock FontSize="12" Foreground="#FFD5D9DC" Text="made by Umberto" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,22,0,20" Background="{StaticResource VibePanelAccentBrush}" Height="1" />

        <Grid Grid.Row="2" ColumnDefinitions="1.1*,0.9*" ColumnSpacing="28">
            <StackPanel Spacing="12">
                <TextBlock FontFamily="Cascadia Mono" FontSize="18" FontWeight="SemiBold" Foreground="White" Text="MY PANEL" />
                <TextBlock Foreground="#FFD5D9DC" TextWrapping="Wrap" Text="Choose the connected panel. I will not touch it until you ask me to." />
                <ListView x:Name="DevicesList" MinHeight="150" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8" Spacing="2">
                                <TextBlock FontFamily="Cascadia Mono" Foreground="White" Text="{Binding Id}" />
                                <TextBlock FontSize="12" Foreground="#FFD5D9DC" Text="WinUSB display interface" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal">
                    <Button Click="Refresh_Click" Content="Refresh" />
                    <Button Click="Probe_Click" Content="Check panel" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="12">
                <TextBlock FontFamily="Cascadia Mono" FontSize="18" FontWeight="SemiBold" Foreground="White" Text="MY FRAME" />
                <TextBlock Foreground="#FFD5D9DC" TextWrapping="Wrap" Text="Pick a profile. The first pattern is deliberately obvious, so I can see if it fits." />
                <ComboBox x:Name="ProfilesBox" DisplayMemberPath="Name" />
                <Button Click="Pattern_Click" Content="Send diagnostic pattern" />
                <TextBlock FontSize="12" Foreground="#FFD5D9DC" TextWrapping="Wrap" Text="A pattern changes the physical display. Check the selected panel and profile first." />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="10">
            <TextBlock x:Name="StatusText" FontFamily="Cascadia Mono" Foreground="White" Text="Ready. Refresh to find my panel." TextWrapping="Wrap" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <TextBlock Foreground="#FFD5D9DC" Text="Part of the VibeWare initiative" />
                <HyperlinkButton NavigateUri="https://umbertogiacobbi.biz/vibeware/manifesto" Content="MANIFESTO" Foreground="#F2C6F6" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
