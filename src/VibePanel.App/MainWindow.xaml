<Window
    x:Class="VibePanel.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VibePanel — my music, my screen">
    <Grid Background="#15191F" RequestedTheme="Dark">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="32,20" Spacing="14" MaxWidth="1300">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Text="VibePanel" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="My music. My apps. My little screen." Foreground="#AEB5C2" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#272331" CornerRadius="10" Padding="18,9">
                        <StackPanel Spacing="1" HorizontalAlignment="Right">
                            <TextBlock Text="VibeWare" Foreground="#DDB0EB" FontWeight="SemiBold" FontSize="18" />
                            <TextBlock Text="by Umberto Giacobbi" Foreground="#AEB5C2" FontSize="11" />
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="MY SCREEN / LIVE PREVIEW" FontFamily="Cascadia Mono" Foreground="#DDB0EB" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="LOCAL ONLY · NO SPOTIFY LOGIN" Foreground="#818A9C" FontSize="11" />
                    </Grid>
                    <Border Background="#202631" CornerRadius="16" BorderBrush="#393346" BorderThickness="1" MinHeight="200">
                        <Grid>
                            <Image x:Name="PreviousPreview" Stretch="Uniform" Height="240" />
                            <Image x:Name="PreviewImage" Stretch="Uniform" Height="240" AutomationProperties.Name="Live panel preview" />
                        </Grid>
                    </Border>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="&#xE892;" FontFamily="Segoe Fluent Icons" Tag="previous" Click="Media_Click" ToolTipService.ToolTip="Previous track" AutomationProperties.Name="Previous track" />
                            <Button x:Name="ToggleButton" Content="Play / pause" Tag="toggle" Click="Media_Click" />
                            <Button Content="&#xE893;" FontFamily="Segoe Fluent Icons" Tag="next" Click="Media_Click" ToolTipService.ToolTip="Next track" AutomationProperties.Name="Next track" />
                        </StackPanel>
                        <TextBlock x:Name="MediaSourceText" Grid.Column="1" Text="Waiting for a Windows media session…" Margin="14,0" VerticalAlignment="Center" Foreground="#AEB5C2" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Content="Refresh preview" Click="DashboardRefresh_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox x:Name="ScenesBox" Width="210" SelectionChanged="Scene_Changed" />
                        <ToggleSwitch x:Name="CycleSwitch" OnContent="Rotate five layouts" OffContent="Keep this layout" IsOn="True" />
                        <TextBlock Text="20 s · short fade" Foreground="#818A9C" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="20">
                    <Border Background="#20252D" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="APP LEVELS" FontFamily="Cascadia Mono" FontSize="13" Foreground="#DDB0EB" />
                            <TextBlock Text="Volume % + live VU · read-only · no microphone capture" Foreground="#AEB5C2" FontSize="12" />
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="MixerRows" Spacing="8" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#20252D" CornerRadius="12" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="SYSTEM / SECONDARY" FontFamily="Cascadia Mono" FontSize="13" Foreground="#DDB0EB" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="CPU" Foreground="#AEB5C2" FontSize="12" />
                                    <TextBlock x:Name="CpuUsageText" Text="—" FontSize="26" />
                                    <TextBlock x:Name="CpuTempText" Text="— °C" FontSize="16" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="GPU" Foreground="#AEB5C2" FontSize="12" />
                                    <TextBlock x:Name="GpuUsageText" Text="—" FontSize="26" />
                                    <TextBlock x:Name="GpuTempText" Text="— °C" FontSize="16" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="SensorSourceText" Text="Existing sensors only. No driver installation." Foreground="#818A9C" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Background="#20252D" CornerRadius="12" Padding="16">
                    <StackPanel x:Name="PanelControls" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="USB DISPLAY" FontFamily="Cascadia Mono" FontSize="13" Foreground="#DDB0EB" />
                            <TextBlock Grid.Column="1" Text="I only send when you press Start." FontSize="12" Foreground="#AEB5C2" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="10">
                            <ComboBox x:Name="DevicesList" PlaceholderText="Choose my panel" DisplayMemberPath="Id" HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="1" x:Name="ProfilesBox" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="2" Content="Refresh" Click="Refresh_Click" />
                            <Button Grid.Column="3" Content="Start dashboard" Click="DashboardStart_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Expander Header="Still images &amp; panel tools" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel x:Name="FrameControls" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="RotationBox" SelectedIndex="0">
                                <x:String>0 degrees</x:String><x:String>90 degrees</x:String><x:String>180 degrees</x:String><x:String>270 degrees</x:String>
                            </ComboBox>
                            <Button Content="Check panel" Click="Probe_Click" />
                            <Button Content="Send pattern" Click="Pattern_Click" />
                            <Button Content="Choose and send image" Click="Image_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ImageLabel" Text="No still image selected" Foreground="#AEB5C2" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Keep displaying image" Click="Play_Click" />
                            <Button Content="Save choices" Click="Save_Click" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Button x:Name="StopButton" Content="Stop display" Click="Stop_Click" IsEnabled="False" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="Preview stays on this PC until you start the USB display." VerticalAlignment="Center" Foreground="#AEB5C2" TextWrapping="Wrap" FontSize="12" />
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="I stand with the VibeWare movement." Foreground="#AEB5C2" VerticalAlignment="Center" FontSize="12" />
                    <HyperlinkButton NavigateUri="https://umbertogiacobbi.biz/vibeware/manifesto" Content="MANIFESTO ↗" Foreground="#DDB0EB" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
