<Application x:Class="VibePanel.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Theme>
        <mt:ModernTheme CurrentPalette="Dark" xmlns:mt="http://opensilver.net/themes/modern" />
    </Application.Theme>
    <Application.Resources>
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MaxDropDownHeight" Value="280" />
        </Style>
        <Style TargetType="TextBox"><Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" /></Style>
        <Style TargetType="CheckBox"><Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" /></Style>
    </Application.Resources>
</Application>
